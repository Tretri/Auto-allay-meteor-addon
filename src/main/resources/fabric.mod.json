{
  "schemaVersion": 1,
  "id": "allay-addon",
  "version": "${version}",
  "name": "Allay Addon",
  "description": "An addon for allay dupe automatization by Tretri. For fabric 1.21.11",
  "authors": [
    "Tretri"
  ],
  "contact": {
    "sources": "https://github.com/MeteorDevelopment/meteor-addon-template"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.allayaddon.AllayAddon"
    ]
  },

  "custom": {
    "meteor-client:color": "55,235,255",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
